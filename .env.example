# Base URL dùng trong mã QR (không có dấu / ở cuối)
# Dùng IP WiFi của máy tính để điện thoại cùng mạng quét được
VITE_PUBLIC_BASE_URL=http://localhost:5173

# API backend (để /api = dùng proxy Vite)
VITE_API_URL=/api

# Target cho Vite proxy (chỉ dùng khi dev) — khớp PORT API
# Local: http://localhost:3001
# Cloud Run: https://qoa-florist-api-....run.app
VITE_API_PROXY_TARGET=http://localhost:3001

# Socket (để trống = cùng origin, Vite proxy /socket.io)
# VITE_SOCKET_URL=

# Zalo — SĐT Zalo shop hoặc Official Account ID
# Ví dụ: 098xxxxxxx → mở https://zalo.me/098xxxxxxx
VITE_ZALO_OA_ID=
VITE_SHOP_NAME=QOA Florist

